APP_NAME=Conversational RAG Platform
# Allowed values: development, test, production
APP_ENV=development
APP_DEBUG=false
API_V1_PREFIX=/api/v1
# Required to access protected API endpoints
APP_API_KEY=replace_with_a_long_random_value
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.6-27b
ASSISTANT_NAME=Knowledge Assistant
ASSISTANT_ROLE=a helpful knowledge-base assistant
ASSISTANT_DOMAIN=the configured knowledge base
ASSISTANT_TONE=clear, concise, and professional
ASSISTANT_LANGUAGE=the same language as the user
ASSISTANT_INSTRUCTIONS=Prefer direct answers and practical steps when the context provides them.
ASSISTANT_FALLBACK_MESSAGE=I do not have enough information in the knowledge base to answer that.
ASSISTANT_PROFILE_PATH=./data/assistant_profile.json
ASSISTANT_PROFILE_EDITING_ENABLED=false
CHROMA_PERSIST_DIRECTORY=./chroma_db
CHROMA_COLLECTION_NAME=knowledge_base
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DEVICE=cpu
# Accepted range: 1 to 20 documents
RETRIEVAL_TOP_K=5
# Accepted range: 0.0 to 1.0
RETRIEVAL_MIN_SCORE=0.35
CONVERSATION_DB_URL=sqlite:///./data/conversations.db
# Accepted range: 1 to 100 messages
CONVERSATION_HISTORY_LIMIT=10
